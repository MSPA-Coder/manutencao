[Unit]
Description=Preenche a serie de cambio do NetWorth
Documentation=file:/home/ubuntu/atualizar-cambio.sh
After=docker.service
Requires=docker.service
OnFailure=alerta@%n.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/home/ubuntu/atualizar-cambio.sh
# O comando consulta as duas fontes e o Yahoo, cada um com seu limite de
# tempo; cinco minutos cobrem os tres lentos ao mesmo tempo com folga.
TimeoutStartSec=300
