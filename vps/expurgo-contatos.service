[Unit]
Description=Aplica a retencao de contatos do aviso de privacidade do portal
Documentation=file:/home/ubuntu/expurgo-contatos.sh
After=docker.service
Requires=docker.service
OnFailure=alerta@%n.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/home/ubuntu/expurgo-contatos.sh
TimeoutStartSec=300
