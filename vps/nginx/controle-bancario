# Vhost do ControleBancario. Cópia de /etc/nginx/sites-available/controle-bancario.
#
# Os quatro vhosts têm estrutura idêntica de propósito: só mudam domínio,
# porta e tamanho máximo de corpo. A exceção é o bloco de `/patrimonio/`, que
# só existe aqui e no `controle-renda-variavel`, os dois que publicam o
# contrato. Cabeçalho de proxy fica em `snippets/proxy-app.conf`, compressão e
# limitador em `conf.d/00-comum.conf`.

server {
    listen 80;
    listen [::]:80;
    server_name bancario-mspa.duckdns.org;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name bancario-mspa.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/bancario-mspa.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bancario-mspa.duckdns.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 10m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Força bruta no login. A zona e a explicação estão em
    # `conf.d/00-comum.conf`; aqui só se escolhe a folga.
    #
    # Regex e não `location = /login` porque os quatro não concordam sobre a
    # barra final -- o `APPEND_SLASH` do Django aceita as duas formas, e uma
    # rota de login que escapasse do limitador por causa de uma barra seria um
    # buraco silencioso.
    #
    # Nenhum `add_header` aqui dentro de propósito: um `add_header` local faz o
    # nginx DESCARTAR os do bloco pai, e o HSTS acima sumiria só nesta rota.
    location ~ ^/login/?$ {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://127.0.0.1:5201;
        include snippets/proxy-app.conf;
    }

    # O patrimônio não sai pela borda (02/10/2026). `/patrimonio/v1` a `v4` são
    # contrato máquina a máquina, autenticado por Bearer, e o único consumidor
    # -- o Wealthfolio -- lê pela rede Docker interna `patrimonio-internal`, sem
    # passar por este nginx. Responder na internet só servia a quem tivesse um
    # token vazado. A recusa acontece antes do proxy: a aplicação nem vê o
    # pedido. A prova está em `tests/nginx_test.sh`.
    #
    # Sem `add_header` aqui, pelo mesmo motivo do bloco de login: o HSTS do
    # `server` continua valendo nesta rota.
    location ^~ /patrimonio/ {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:5201;
        include snippets/proxy-app.conf;
    }
}
