# Servidores padrão de HTTPS e de HTTP: recusam requisição com `Host` que não é
# de nenhum dos domínios da máquina.
#
# POR QUE EXISTE: sem um `default_server` na 443, o nginx atende `Host`
# desconhecido com o primeiro bloco `server` carregado. Um domínio sem
# correspondência não deve receber conteúdo de nenhuma aplicação.
#
# A porta 80 também tem o seu servidor padrão aqui (25/10/2026). Antes ela
# ficava com o `default` do pacote do Ubuntu, que mostrava "Welcome to nginx"
# (e a versão) a quem chegasse pelo IP; o instalador desabilita esse site. O
# desafio ACME continua respondido a partir de `/var/www/html`, como o `default`
# fazia, para o certificado de um domínio novo poder ser emitido antes do vhost
# dele existir.
#
# `ssl_reject_handshake on` (nginx 1.19.4+) corta a conexão
# ainda no aperto de mão TLS. É melhor que responder 444 depois de estabelecer
# a sessão por dois motivos: não gasta certificado nem CPU de handshake com
# quem não deveria estar ali, e não revela nenhum dos certificados — o nome do
# domínio no certificado é informação, e um servidor padrão que apresenta o
# certificado do ConfortoTermico entrega a lista de domínios a quem só tinha o
# IP.

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;

    ssl_reject_handshake on;
}

# 444 fecha a conexão sem resposta nenhuma: nem página, nem versão.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 444;
    }
}
