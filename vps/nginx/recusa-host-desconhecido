# Servidor padrão de HTTPS: recusa requisição com `Host` que não é de nenhum
# dos quatro domínios.
#
# POR QUE EXISTE: sem um `default_server` na 443, o nginx atende `Host`
# desconhecido com o primeiro bloco `server` carregado. Um domínio sem
# correspondência não deve receber conteúdo de nenhuma aplicação.
#
# A porta 80 usa o `default_server` do pacote do Ubuntu em
# `/etc/nginx/sites-available/default`. Este arquivo trata apenas a 443 e não
# conflita com esse site.
#
# `ssl_reject_handshake on` (nginx 1.19.4+) corta a conexão
# ainda no aperto de mão TLS. É melhor que responder 444 depois de estabelecer
# a sessão por dois motivos: não gasta certificado nem CPU de handshake com
# quem não deveria estar ali, e não revela nenhum dos certificados — o nome do
# domínio no certificado é informação, e um servidor padrão que apresenta o
# certificado do ConfortoTermico entrega a lista de domínios a quem só tinha o
# IP.

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;

    ssl_reject_handshake on;
}
