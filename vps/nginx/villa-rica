# Painel estático Villa Rica. O checkout privado contém exclusivamente os
# arquivos públicos selecionados; dados de trabalho não são publicados.
server {
    listen 80;
    listen [::]:80;
    server_name villa-rica.duckdns.org;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name villa-rica.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/villa-rica.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/villa-rica.duckdns.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    # Cabeçalhos no `server` e nenhum `add_header` em `location` (um local
    # descartaria estes). A página de contas tem `<script>` e `<style>`
    # embutidos e um iframe `srcdoc` montado por JS, por isso `'unsafe-inline'`;
    # o ganho aqui é fechar origem externa, formulário e moldura de terceiro.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
    root /home/ubuntu/apps/villa-rica;
    index contas-villa-rica-2026.html;

    # A sonda permanece pública; o conteúdo financeiro exige autenticação.
    location = /health {
        default_type application/json;
        return 200 '{"status":"ok"}\n';
    }

    location ~ /\. {
        return 404;
    }

    # Lista de permissão: só as duas páginas e `assets/`. `AGENTS.md`,
    # `README.md` e `conferencia/` (repositório aninhado, com dados de
    # trabalho) caem no `location /` abaixo e dão 404 antes da autenticação.
    # PÁGINA OU PASTA NOVA DO SITE PRECISA ENTRAR NESTA LISTA, senão dá 404.
    location ~ ^/(?:contas-villa-rica-2026\.html|sugestoes-convencao-regulamento-villa-rica\.html|assets/[^/]+)?$ {
        limit_req zone=basica burst=120 nodelay;
        auth_basic "Villa Rica";
        auth_basic_user_file /etc/nginx/segredos/villa-rica.htpasswd;
        try_files $uri $uri/ =404;
    }

    location / {
        return 404;
    }
}
