# Site estático Viva Passo. O conteúdo é o checkout privado em
# /home/ubuntu/apps/viva-passo; o deploy.sh é o único caminho que o atualiza.
server {
    listen 80;
    listen [::]:80;
    server_name viva-mspa.duckdns.org;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name viva-mspa.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/viva-mspa.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/viva-mspa.duckdns.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    # Cabeçalhos no `server` e nenhum `add_header` em `location`: um local
    # descartaria estes (mesma regra do HSTS nos vhosts dos apps). O estilo
    # inline fica permitido porque o `app.js` monta `style="height:..%"` nas
    # barras da semana. O Google Fonts sai com a SEG-6 do relatório.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
    root /home/ubuntu/apps/viva-passo;
    index index.html;

    location = /health {
        default_type application/json;
        return 200 '{"status":"ok"}\n';
    }

    # A raiz é o checkout: `.git` e qualquer arquivo oculto ficam de fora mesmo
    # para quem tem a senha, para que ela não entregue o histórico inteiro.
    location ~ /\. {
        return 404;
    }

    # Lista de permissão: só o que o `index.html` carrega é servido. O resto do
    # checkout (`AGENTS.md`, `README.md`, `PLANO_*.md`, `Dockerfile*`,
    # `compose.yaml`, `tests/`) cai no `location /` abaixo e dá 404 antes da
    # autenticação, nem com senha se lê. ARQUIVO NOVO DO SITE (outro `.css`,
    # `.js` ou pasta) PRECISA ENTRAR NESTA LISTA, senão responde 404.
    location ~ ^/(?:index\.html|app\.js|styles\.css|anatomy\.css|tracking\.css|builder\.css|assets/[^/]+)?$ {
        # O site guarda dados pessoais de saúde. A conta temporária fica neste
        # arquivo protegido do VPS, fora do checkout e fora do Git.
        limit_req zone=basica burst=120 nodelay;
        auth_basic "Viva Passo";
        auth_basic_user_file /etc/nginx/segredos/viva-passo.htpasswd;
        try_files $uri $uri/ /index.html;
    }

    location / {
        return 404;
    }
}
