[Unit]
Description=Reconstrói semanalmente os apps com tags-base móveis
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/home/ubuntu
UMask=0077
ExecStart=/home/ubuntu/atualizar-stacks.sh --refresh
TimeoutStartSec=6h
