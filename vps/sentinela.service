[Unit]
Description=Le o log de 5xx do nginx e alerta erro de aplicacao
After=network-online.target nginx.service
Wants=network-online.target
OnFailure=alerta@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
# `adm` e o grupo dono dos logs do nginx no Ubuntu. Declarar aqui torna a
# dependencia explicita: sem ele o script nao le nada e alerta a propria
# cegueira, em vez de passar em silencio.
SupplementaryGroups=adm
ExecStart=/home/ubuntu/sentinela.sh
TimeoutStartSec=120
