# Bot de status do Telegram (menu /status). O Telegram entrega os cliques a um
# único processo por bot: dois processos com o mesmo token brigariam pelos
# cliques (HTTP 409). Hoje só existe o VPS1 (ver o cabeçalho de
# `telegram-bot-status.py`).
[Unit]
Description=Bot de status do VPS via Telegram
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
ExecStart=/usr/bin/python3 /home/ubuntu/telegram-bot-status.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
